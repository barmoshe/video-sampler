{
  "name": "video-sampler",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A playable video sampler: every note plays a clip, picture and sound repitched together, every sounding note composed into a live collage.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "check": "node tools/check.mjs"
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28",
    "mediabunny": "^1.65.2",
    "pitchy": "^4.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "oxlint": "^1.92.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  }
}
